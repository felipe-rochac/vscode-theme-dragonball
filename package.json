{
  "name": "vscode-theme-dragonball",
  "displayName": "Dragon Ball Themes - Professional Dark Themes",
  "description": "Professional Dragon Ball-inspired VS Code themes with One Dark-style rich syntax highlighting, 50+ scopes, and excellent readability. Zed editor compatible.",
  "version": "2.2.1",
  "publisher": "kyrone",
  "license": "MIT",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipe-rochac/vscode-theme-dragonball"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "keywords": [
    "theme",
    "dark theme",
    "dragon ball",
    "anime",
    "goku",
    "vegeta",
    "one dark",
    "professional",
    "high contrast",
    "zed"
  ],
  "sponsor": {
    "url": "https://www.paypal.com/donate/?business=BJ8V7HA6L9KRG&no_recurring=0&item_name=Developing+and+maintaining+extensions+takes+time+and+effort%2C+please+consider+supporting+development+through+a+small+donation.&currency_code=CAD"
  },
  "categories": [
    "Themes"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:dragonBall.workspaceColors.configure",
    "onCommand:dragonBall.workspaceColors.disable",
    "onStartupFinished"
  ],
  "scripts": {
    "lint": "eslint src scripts test",
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "mocha test/workspace-colors.test.js",
    "test:integration": "node scripts/build.js && node test/run-extension-tests.js",
    "vscode:prepublish": "npm run build",
    "package:local": "node scripts/package.js",
    "verify:vsix": "node scripts/verify-vsix.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "2.32.0",
    "eslint": "9.11.1",
    "mocha": "10.7.3",
    "yauzl": "3.1.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "dragonBall.workspaceColors.configure",
        "title": "Dragon Ball: Configure Workspace Colors"
      },
      {
        "command": "dragonBall.workspaceColors.disable",
        "title": "Dragon Ball: Disable Workspace Colors"
      }
    ],
    "themes": [
      {
        "label": "Dragon Ball Goku",
        "uiTheme": "vs-dark",
        "path": "./themes/goku-color-theme.json"
      },
      {
        "label": "Dragon Ball Vegeta",
        "uiTheme": "vs-dark",
        "path": "./themes/vegeta-color-theme.json"
      },
      {
        "label": "Dragon Ball Frieza",
        "uiTheme": "vs-dark",
        "path": "./themes/frieza-color-theme.json"
      },
      {
        "label": "Dragon Ball Piccolo",
        "uiTheme": "vs-dark",
        "path": "./themes/piccolo-color-theme.json"
      },
      {
        "label": "Dragon Ball Gohan",
        "uiTheme": "vs-dark",
        "path": "./themes/gohan-color-theme.json"
      },
      {
        "label": "Dragon Ball Super Saiyan Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/super-saiyan-blue-color-theme.json"
      },
      {
        "label": "Dragon Ball Trunks",
        "uiTheme": "vs-dark",
        "path": "./themes/trunks-color-theme.json"
      },
      {
        "label": "Dragon Ball",
        "uiTheme": "vs-dark",
        "path": "./themes/dragon-ball-color-theme.json"
      },
      {
        "label": "Dragon Ball Beerus",
        "uiTheme": "vs-dark",
        "path": "./themes/beerus-color-theme.json"
      },
      {
        "label": "Dragon Ball Broly",
        "uiTheme": "vs-dark",
        "path": "./themes/broly-color-theme.json"
      },
      {
        "label": "Dragon Ball Android 18",
        "uiTheme": "vs-dark",
        "path": "./themes/android-18-color-theme.json"
      },
      {
        "label": "Dragon Ball Cell",
        "uiTheme": "vs-dark",
        "path": "./themes/cell-color-theme.json"
      },
      {
        "label": "Dragon Ball Majin Buu",
        "uiTheme": "vs-dark",
        "path": "./themes/majin-buu-color-theme.json"
      },
      {
        "label": "Dragon Ball Jiren",
        "uiTheme": "vs-dark",
        "path": "./themes/jiren-color-theme.json"
      },
      {
        "label": "Dragon Ball Super Saiyan 4",
        "uiTheme": "vs-dark",
        "path": "./themes/super-saiyan-4-color-theme.json"
      }
    ]
  }
}
